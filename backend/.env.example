# Counterpart backend settings. Copy to backend/.env:  cp .env.example .env
# Step-by-step instructions for every key: docs/SETUP.md
# Secrets: save them with `uv run python -m scripts.set_secret NAME` (typed hidden, tested before saving).
# Never put a note on the same line as a value: everything after "=" becomes the value.

# === REQUIRED ====================================================================

# --- Database (Supabase Postgres) -----------------------------------------------
# Dashboard > your project > Connect > "Session pooler" (IPv4, port 5432). Then run
#   uv run python -m scripts.set_db_password
# which asks for this string and the password, tests the connection and writes it here.
# Shape: postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Offline dev instead: `uv run python -m scripts.dev_db` prints a local URL.
DATABASE_URL=

# --- Supabase Auth and Storage ---------------------------------------------------
# Dashboard > Project Settings > Data API > Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=
# Dashboard > Project Settings > API Keys > Publishable key (sb_publishable_...). Not secret; used server-side only.
SUPABASE_PUBLISHABLE_KEY=
# Dashboard > Project Settings > API Keys > Secret keys (sb_secret_...). Creates accounts and uploads files.
#   uv run python -m scripts.set_secret SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=

# --- Text model (at least one of Gemini, Groq, Cerebras or Agnes) ------------------
# https://aistudio.google.com/apikey > Create API key. Free tier: about 20 requests per day PER MODEL.
#   uv run python -m scripts.set_secret GEMINI_API_KEY
GEMINI_API_KEY=

# --- Agnes: AI pictures and last text fallback --------------------------------------
# https://apihub.agnes-ai.com > API keys.
#   uv run python -m scripts.set_secret AGNES_API_KEY
AGNES_API_KEY=

# --- Demo ----------------------------------------------------------------------
# "Try the demo" signs in as DEMO_EMAIL with this password (account is created on first use).
#   uv run python -m scripts.set_secret DEMO_PASSWORD
DEMO_PASSWORD=
# DEMO_EMAIL=demo@counterpart.app

# --- URLs ------------------------------------------------------------------------
# Public origin of the frontend (QR codes and links point here).
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

# local (dev) | supabase (deployed: containers have ephemeral disks)
STORAGE_BACKEND=local
# SUPABASE_BUCKET=campaign-assets

# off | record | replay   (replayed outputs are labelled "Saved output" in the UI)
REPLAY_MODE=off

# === OPTIONAL ====================================================================
# Uncomment only the lines you use. Every one of these features works or degrades gracefully without its key.

# --- Free backup text models (tried after Gemini, before Agnes) ----------------------
# Gemini key from a DIFFERENT Google project (free quota is per project).
# GEMINI_API_KEY_2=
# console.groq.com > API Keys (gsk_...), no card.
# GROQ_API_KEY=
# cloud.cerebras.ai > API Keys (csk-...), no card.
# CEREBRAS_API_KEY=

# --- Sarvam AI: Kannada/Hindi voice briefs and independent translation ------------------
# dashboard.sarvam.ai > API Keys.
# SARVAM_API_KEY=

# --- Google Maps photos and "sign up from a Maps link" -----------------------------------
# console.cloud.google.com: enable "Places API (New)", link billing, Credentials > Create API key.
# GOOGLE_MAPS_API_KEY=
# AI picture when a business has no usable photo yet (labelled in the UI)
# AI_PICTURE_FALLBACK=true

# --- WhatsApp and Instagram (docs/CHANNELS.md) ---------------------------------------
# developers.facebook.com > your app > App settings > Basic > App secret (32 hex characters).
# META_APP_SECRET=
# Any phrase of 8+ characters, no spaces; type the same one into Meta's webhook form.
# WHATSAPP_VERIFY_TOKEN=

# --- Shared secret between the Next.js server and this API ---------------------------
# Set the SAME value in frontend/.env.local. Recommended when deployed.
# OWNER_API_TOKEN=

# --- Any other OpenAI-compatible model (provider name "alt" in ROLE_* chains) --------------
# ALT_LLM_BASE_URL=
# ALT_LLM_API_KEY=
# ALT_LLM_MODEL=

# --- Model tuning (defaults in app/config.py are fine) ---------------------------------
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.7-flash,gemini-3.8-flash
# ROLE_REASONING=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash,agnes
# ROLE_GENERATION=gemini-3.6-flash,gemini-3-flash-preview,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.7-flash,agnes
# ROLE_VERIFICATION=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-3-flash-preview,gemini-3.6-flash,gemini-3.8-flash,agnes
# ROLE_IMAGE=agnes
# ROLE_VISION=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash
# AGNES_TEXT_RPM=10
# AGNES_IMAGE_RPM=10
